---

<section class="social" id="redes">
  <div class="container">
    <div class="social__header reveal">
      <span class="badge">Síguenos</span>
      <h2 class="section-title">Somos comunidad<br/><span>en redes sociales</span></h2>
      <p class="section-subtitle">
        Mira entrenamientos de la escuela permanente, partidos y la vida diaria del club.
        ¡Únete a nuestra comunidad digital!
      </p>
    </div>

    <div class="social__grid">
      {socials.map((s, i) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          class="social-card reveal"
          style={`transition-delay:${i * 0.1}s; --card-color:${s.color}; --card-bg:${s.bgColor};`}
        >
          <div class="social-card__icon-wrap">
            <span class="social-card__icon" set:html={svgIcons[s.icon]} style={`color:${s.color}`} />
          </div>
          <div class="social-card__body">
            <h3 class="social-card__name">{s.name}</h3>
            <p class="social-card__handle">{s.handle}</p>
            <p class="social-card__desc">{s.desc}</p>
          </div>
          <span class="social-card__arrow">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .social {
    padding: var(--section-padding);
    background: var(--color-bg);
  }

  .social__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 3.5rem;
  }

  .social__header span {
    color: var(--color-primary);
  }

  .social__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
  }

  @media (max-width: 1100px) {
    .social__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 720px) {
    .social__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 460px) {
    .social__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Card */
  .social-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    background: var(--color-white);
    border: 2px solid var(--color-gray-light);
    border-radius: var(--radius-md);
    padding: 1rem;
    transition: var(--transition);
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  .social-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--card-color);
    border-radius: 0;
    transition: width var(--transition);
  }

  .social-card:hover {
    border-color: var(--card-color);
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    transform: translateY(-3px);
  }

  .social-card:hover::before {
    width: 6px;
  }

  .social-card__icon-wrap {
    background: var(--card-bg);
    border-radius: var(--radius-md);
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .social-card__icon {
    width: 26px;
    height: 26px;
    display: flex;
  }

  .social-card__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .social-card__body {
    flex: 1;
    min-width: 0;
  }

  .social-card__name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1rem;
    color: var(--color-dark);
    margin-bottom: 0.1rem;
  }

  .social-card__handle {
    font-size: 0.78rem;
    color: var(--card-color);
    font-weight: 600;
    margin-bottom: 0.3rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .social-card__desc {
    font-size: 0.8rem;
    color: var(--color-gray);
    line-height: 1.4;
  }

  .social-card__arrow {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    font-size: 1rem;
    color: var(--color-gray);
    transition: var(--transition);
    flex-shrink: 0;
  }

  .social-card:hover .social-card__arrow {
    color: var(--card-color);
    transform: translateX(3px);
  }
</style>
