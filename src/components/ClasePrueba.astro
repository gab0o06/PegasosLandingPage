---
// src/components/ClasePrueba.astro
// Sección dedicada al detalle de la clase de prueba GRATIS y preguntas frecuentes (FAQs),
// integrando la información de la categoría Formativa y el Equipo Absoluto Masculino.

import WhatsAppIcon from './WhatsAppIcon.astro';

const WA_PRUEBA = 'https://wa.me/593984917908?text=%C2%A1Hola%20Pegasos!%20%F0%9F%8F%90%20Quiero%20agendar%20mi%20clase%20de%20prueba%20GRATIS.';

const steps = [
  {
    step: '01',
    icon: '📲',
    title: 'Agenda por WhatsApp',
    desc: 'Escríbenos directamente o haz clic en el botón. Coordinamos el día que prefieras (sábado o domingo) en minutos.',
  },
  {
    step: '02',
    icon: '🏐',
    title: 'Elige tu Nivel',
    desc: 'Contamos con Escuela Formativa (8 a 17 años) y Equipo Absoluto Masculino para jugadores con experiencia previa.',
  },
  {
    step: '03',
    icon: '👟',
    title: '¿Qué implementos llevar?',
    desc: 'Únicamente ropa deportiva cómoda, calzado deportivo con buen agarre y tu botella de agua. Nosotros ponemos los balones y la infraestructura.',
  },
  {
    step: '04',
    icon: '⏰',
    title: 'Entrena y Decide',
    desc: 'Sábados y domingos de 8:00 a 10:00 am en Canchas de la Luz. Vive la experiencia y el ritmo del club 100% libre de costo.',
  },
];

const faqs = [
  {
    q: '¿Cómo funciona la clase de prueba GRATIS?',
    a: 'Solo debes hacer clic en cualquiera de nuestros botones de WhatsApp, coordinamos el día que prefieras (sábado o domingo de 8:00 a 10:00 am) y asistes sin ningún costo ni compromiso previo.',
  },
  {
    q: '¿Qué implementos se necesitan para la primera clase?',
    a: 'Únicamente ropa deportiva cómoda, zapatillas deportivas con buen agarre y tu botella de agua para hidratación. Nosotros proveemos balones, conos e infraestructura técnica.',
  },
  {
    q: '¿Mi hijo/a nunca ha practicado voleibol, puede unirse?',
    a: '¡Totalmente! En la categoría Formativa enseñamos la técnica desde cero con metodología progresiva y adecuada a su ritmo.',
  },
  {
    q: '¿Se cuenta con equipo para jugadores avanzados o adultos?',
    a: '¡Sí! Contamos con el Equipo Absoluto Masculino, orientado a jugadores con experiencia que buscan máxima exigencia física, sistemas de juego competitivos (5-1) y ritmo de torneos en Quito.',
  },
  {
    q: '¿Qué días y en qué horarios entrenan?',
    a: 'Entrenamos los fines de semana: sábados y domingos de 8:00 a 10:00 am en Canchas de La Luz, Quito.',
  },
];
---

<section class="trial-section" id="clase-gratis">
  <div class="container">

    <!-- Cabecera -->
    <div class="trial__header reveal">
      <span class="badge">💥 Sin Costo Inicial · Sin Compromiso</span>
      <h2 class="section-title">
        Tu primera clase de prueba<br/>
        <span>es totalmente GRATIS</span>
      </h2>
      <p class="section-subtitle">
        Ven a la cancha, conoce a los entrenadores, entrena con el equipo y vive la pasión
        del Club Pegasos antes de tomar una decisión.
      </p>
    </div>

    <!-- Pasos / Cómo funciona -->
    <div class="trial__steps-grid">
      {steps.map((s, idx) => (
        <div class="trial-card reveal" style={`transition-delay: ${idx * 0.1}s;`}>
          <div class="trial-card__top">
            <span class="trial-card__icon">{s.icon}</span>
            <span class="trial-card__step">{s.step}</span>
          </div>
          <h3 class="trial-card__title">{s.title}</h3>
          <p class="trial-card__desc">{s.desc}</p>
        </div>
      ))}
    </div>

    <!-- Banner de Conversión Destacado -->
    <div class="trial__banner reveal">
      <div class="trial__banner-content">
        <span class="trial__banner-tag">¡Ven a probar tu nivel!</span>
        <h3 class="trial__banner-title">
          ¿Listo para saltar a la cancha este fin de semana?
        </h3>
        <p class="trial__banner-text">
          Entrenamientos todos los sábados y domingos de <strong>8:00 a 10:00 am</strong> en Canchas de la Luz.
          Cupos limitados por grupo para garantizar atención técnica personalizada.
        </p>
      </div>
      <div class="trial__banner-action">
        <a
          href={WA_PRUEBA}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary trial__banner-btn"
        >
          <WhatsAppIcon size={20} />
          <span>Agendar Clase de Prueba GRATIS →</span>
        </a>
        <small class="trial__banner-note">Atención rápida por WhatsApp · Sin costo</small>
      </div>
    </div>

    <!-- Preguntas Frecuentes (FAQs) -->
    <div class="trial__faqs reveal">
      <div class="trial__faqs-header">
        <span class="badge">Resolvemos tus dudas</span>
        <h3 class="section-title" style="font-size: clamp(1.5rem, 3vw, 2.2rem);">
          Preguntas Frecuentes
        </h3>
      </div>

      <div class="trial__faqs-grid">
        {faqs.map((faq, i) => (
          <details class="faq-item" open={i === 0}>
            <summary class="faq-question">
              <span class="faq-icon">🏐</span>
              <span class="faq-title">{faq.q}</span>
              <span class="faq-arrow">▾</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .trial-section {
    padding: var(--section-padding);
    background: var(--color-bg);
  }

  .trial__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 3.5rem;
  }

  .trial__header span {
    color: var(--color-secondary);
  }

  /* Grid de pasos */
  .trial__steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .trial-card {
    background: var(--color-white);
    border: 2px solid var(--color-gray-light);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    position: relative;
    overflow: hidden;
  }

  .trial-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .trial-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .trial-card__icon {
    font-size: 2.2rem;
    line-height: 1;
  }

  .trial-card__step {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--color-primary-light);
  }

  .trial-card__title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-dark);
  }

  .trial-card__desc {
    font-size: 0.92rem;
    color: var(--color-gray);
    line-height: 1.6;
  }

  /* Banner de Conversión */
  .trial__banner {
    background: linear-gradient(
      135deg,
      var(--color-dark) 0%,
      var(--color-dark-2) 60%,
      var(--color-primary) 100%
    );
    border-radius: var(--radius-lg);
    padding: 3rem 2.5rem;
    color: var(--color-white);
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: center;
    box-shadow: var(--shadow-lg);
    margin-bottom: 4.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 860px) {
    .trial__banner {
      flex-direction: row;
      justify-content: space-between;
      padding: 3.5rem 3rem;
    }
  }

  .trial__banner-content {
    max-width: 620px;
  }

  .trial__banner-tag {
    display: inline-block;
    background: rgba(61, 154, 108, 0.25);
    color: #6ee7b7;
    border: 1px solid rgba(110, 231, 183, 0.4);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
    margin-bottom: 0.85rem;
  }

  .trial__banner-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    font-weight: 900;
    line-height: 1.2;
    color: var(--color-white);
    margin-bottom: 0.85rem;
  }

  .trial__banner-text {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.65;
  }

  .trial__banner-text strong {
    color: #a7f3d0;
  }

  .trial__banner-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .trial__banner-btn {
    font-size: 1.05rem;
    padding: 1.1rem 2rem;
    box-shadow: 0 4px 20px rgba(61, 154, 108, 0.4);
    white-space: nowrap;
  }

  .trial__banner-btn:hover {
    box-shadow: 0 6px 28px rgba(61, 154, 108, 0.6);
  }

  .trial__banner-note {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.7);
  }

  /* FAQs */
  .trial__faqs {
    max-width: 820px;
    margin-inline: auto;
  }

  .trial__faqs-header {
    text-align: center;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .trial__faqs-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: var(--color-white);
    border: 2px solid var(--color-gray-light);
    border-radius: var(--radius-md);
    transition: var(--transition);
    overflow: hidden;
  }

  .faq-item[open] {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .faq-question {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.2rem 1.5rem;
    cursor: pointer;
    user-select: none;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--color-dark);
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .faq-title {
    flex: 1;
  }

  .faq-arrow {
    font-size: 1.1rem;
    color: var(--color-primary);
    transition: transform 0.25s ease;
  }

  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 1.5rem 1.35rem 3.6rem;
    color: var(--color-gray);
    font-size: 0.95rem;
    line-height: 1.65;
  }
</style>
