---
// src/components/Galeria.astro
// Galería de fotos del club. Agrega o quita imágenes en el array.

const fotos = [
  { src: '/images/equipo.jpg',        alt: 'Jugadores de Pegasos Volleyball en huddles' },
  { src: '/images/entrenamiento.jpg', alt: 'Entrenamiento de voleibol en las canchas' },
  { src: '/images/accion.jpg',        alt: 'Jugadora preparando un remate' },
  { src: '/images/about.jpg',         alt: 'Jugador con el uniforme oficial de Pegasos' },
  { src: '/images/hero.jpg',          alt: 'Grupo de jugadores de Pegasos Volleyball' },
];
---

<section class="galeria" id="galeria">
  <div class="container">
    <div class="galeria__header reveal">
      <span class="badge">Galería</span>
      <h2 class="section-title">La vida en<br/><span>las canchas</span></h2>
      <p class="section-subtitle">
        Entrenamientos, juegos y comunidad — esto es Pegasos Volleyball.
      </p>
    </div>

    <div class="galeria__grid">
      {fotos.map((f, i) => (
        <figure class="galeria__item reveal" style={`transition-delay:${i * 0.1}s`}>
          <img src={f.src} alt={f.alt} loading="lazy" />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .galeria {
    padding: var(--section-padding);
    background: var(--color-bg-alt);
  }

  .galeria__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .galeria__header span {
    color: var(--color-primary);
  }

  .galeria__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
  }

  @media (max-width: 1100px) {
    .galeria__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 720px) {
    .galeria__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 460px) {
    .galeria__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 1600px) {
    .galeria__grid {
      gap: 1.5rem;
    }
  }

  .galeria__item {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    aspect-ratio: 4/3;
  }

  .galeria__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .galeria__item:hover img {
    transform: scale(1.06);
  }
</style>
