---
// src/components/Permanente.astro
// Sección de la Escuela Permanente de Voleibol.

import WhatsAppIcon from './WhatsAppIcon.astro';

const highlights = [
  { icon: '📅', text: 'Entrenamientos todo el año, fines de semana' },
  { icon: '⏰', text: 'Horario: sábados y domingos 10:00 a 12:30' },
  { icon: '👦', text: 'Niños y jóvenes de 8 a 17 años' },
  { icon: '📈', text: 'Metodología progresiva: bases, táctica y competencia' },
  { icon: '📍', text: 'Sede: Canchas de la Luz, Quito' },
  { icon: '👨‍🏫', text: 'Entrenadores con experiencia formativa' },
];
---

<section class="permanente" id="permanente">
  <div class="permanente__inner">
    <div class="container permanente__grid">

      <!-- Texto -->
      <div class="permanente__content reveal">
        <span class="badge badge--light">🏐 Escuela Permanente</span>
        <h2 class="section-title" style="color: var(--color-white);">
          Entrena todo el año<br/>
          <span class="permanente__accent">con los Pegasos</span>
        </h2>
        <p style="color: rgba(255,255,255,0.85); line-height: 1.75; margin-bottom: 1.5rem;">
          La Escuela Permanente es el corazón del club: entrenamientos
          semanales de calidad, con metodología progresiva y grupos por
          edad y nivel. Aquí se forman los jugadores desde cero y se
          preparan los que ya compiten.
        </p>

        <ul class="permanente__features">
          {highlights.map(f => (
            <li class="permanente__feature">
              <span class="permanente__feature-icon">{f.icon}</span>
              <span>{f.text}</span>
            </li>
          ))}
        </ul>

        <div style="margin-top: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
          <a
            href="https://wa.me/593984917908?text=Hola!%20Quiero%20inscribirme%20en%20la%20escuela%20permanente%20de%20Pegasos%20Volleyball"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            <WhatsAppIcon size={18} />
            Inscribirme — WhatsApp
          </a>
          <a href="#galeria" class="btn btn-outline">Ver galería ↓</a>
        </div>
      </div>

      <!-- Tarjeta destacada -->
      <div class="permanente__card reveal" style="transition-delay: 0.2s;">
        <img
          src="/images/equipo.jpg"
          alt="Jugadores de Pegasos Volleyball"
          class="permanente__card-img"
          loading="lazy"
        />
        <div class="permanente__card-body">
          <h3>Escuela Permanente</h3>
          <div class="permanente__card-row">
            <span>Edad</span>
            <strong>8 – 17 años</strong>
          </div>
          <div class="permanente__card-row">
            <span>Horario</span>
            <strong>Sáb y Dom 10:00 – 12:30</strong>
          </div>
          <div class="permanente__card-row">
            <span>Lugar</span>
            <strong>Canchas de la Luz, Quito</strong>
          </div>
          <div class="permanente__card-row">
            <span>Contacto</span>
            <strong>0984917908</strong>
          </div>
          <div class="permanente__card-row">
            <span>Inscripciones</span>
            <strong style="color: var(--color-secondary);">🟢 Abiertas</strong>
          </div>
        </div>
        <a
          href="https://wa.me/593984917908?text=Hola!%20Quiero%20inscribirme%20en%20la%20escuela%20permanente%20de%20Pegasos%20Volleyball"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary permanente__card-cta"
        >
          <WhatsAppIcon size={18} />
          Inscribirme ahora →
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .permanente {
    position: relative;
    overflow: hidden;
  }

  .permanente__inner {
    background: linear-gradient(
      135deg,
      var(--color-dark-2) 0%,
      var(--color-primary-dark) 100%
    );
    padding: var(--section-padding);
  }

  .permanente__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3.5rem;
    align-items: center;
  }

  .permanente__accent {
    color: var(--color-secondary);
  }

  .badge--light {
    background: rgba(255,255,255,0.14);
    color: var(--color-white);
  }

  .permanente__features {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .permanente__feature {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: rgba(255,255,255,0.9);
    font-size: 0.95rem;
  }

  .permanente__feature-icon {
    font-size: 1.15rem;
    flex-shrink: 0;
    width: 2rem;
    text-align: center;
  }

  /* Tarjeta */
  .permanente__card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0,0,0,0.28);
    display: flex;
    flex-direction: column;
  }

  .permanente__card-img {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
  }

  .permanente__card-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .permanente__card-body h3 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.2rem;
    color: var(--color-dark);
    margin-bottom: 0.25rem;
  }

  .permanente__card-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.9rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--color-gray-light);
  }

  .permanente__card-row span {
    color: var(--color-gray);
    font-weight: 600;
  }

  .permanente__card-row strong {
    color: var(--color-dark);
    text-align: right;
  }

  .permanente__card-cta {
    margin: 0 1.75rem 1.75rem;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .permanente__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
