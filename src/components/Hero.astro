---
// src/components/Hero.astro
// Sección principal (hero). Edita el título, subtítulo y botones.

const stats = [
  { value: 'Formativa & Absoluto', label: '8-17 años y adultos' },
  { value: '8:00 – 10:00', label: 'Sáb y Dom am' },
  { value: 'Canchas de la Luz', label: 'Sede Norte Quito' },
  { value: '100% Gratis', label: 'Clase de prueba' },
];

import WhatsAppIcon from './WhatsAppIcon.astro';
---

<section class="hero" id="inicio">
  <!-- Fondo con foto y patrón decorativo -->
  <div class="hero__bg">
    <img src="/images/hero.jpg" alt="" class="hero__photo" aria-hidden="true" />
    <div class="hero__overlay"></div>
    <div class="hero__shape hero__shape--1"></div>
    <div class="hero__shape hero__shape--2"></div>
    <div class="hero__volleyball">🏐</div>
  </div>

  <div class="container hero__content">
    <div class="hero__text reveal">
      <span class="badge">🏆 Quito · Ecuador</span>
      <h1 class="hero__title">
        Más que voleibol,<br/>
        <span class="hero__title-accent">formamos campeones</span>
      </h1>
      <p class="hero__description">
        Somos <strong>Pegasos Volleyball UIO</strong> en Quito. Contamos con
        <strong>Escuela Formativa (8 a 17 años)</strong> y <strong>Equipo Absoluto Masculino</strong>.
        Entrenamos en Canchas de la Luz los fines de semana de <strong>8:00 a 10:00 am</strong>.
        Disciplina, técnica y pasión — mucho más que una idea de negocio.
      </p>
      <div class="hero__actions">
        <a
          href="https://wa.me/593984917908?text=%C2%A1Hola%20Pegasos!%20%F0%9F%8F%90%20Quiero%20agendar%20mi%20clase%20de%20prueba%20GRATIS."
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
        >
          <WhatsAppIcon size={18} />
          Clase de prueba GRATIS
        </a>
        <a href="#clase-gratis" class="btn btn-outline">¿Cómo funciona? ↓</a>
      </div>
    </div>

    <!-- Stats -->
    <div class="hero__stats reveal">
      {stats.map(stat => (
        <div class="hero__stat">
          <span class="hero__stat-value">{stat.value}</span>
          <span class="hero__stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Ola decorativa inferior -->
  <div class="hero__wave" aria-hidden="true">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none">
      <path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z" fill="var(--color-bg)" />
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: linear-gradient(
      135deg,
      var(--color-dark) 0%,
      var(--color-dark-2) 50%,
      #12455c 100%
    );
    overflow: hidden;
    padding-top: 72px; /* offset navbar */
  }

  /* Foto de fondo */
  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(11, 46, 61, 0.88) 0%,
      rgba(11, 46, 61, 0.72) 50%,
      rgba(18, 69, 92, 0.82) 100%
    );
  }

  /* Fondo decorativo */
  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__shape {
    position: absolute;
    border-radius: 50%;
    opacity: 0.07;
  }

  .hero__shape--1 {
    width: 600px;
    height: 600px;
    background: var(--color-primary);
    top: -150px;
    right: -150px;
  }

  .hero__shape--2 {
    width: 400px;
    height: 400px;
    background: var(--color-secondary);
    bottom: -100px;
    left: -100px;
  }

  .hero__volleyball {
    position: absolute;
    font-size: 20rem;
    opacity: 0.04;
    right: 5%;
    top: 50%;
    transform: translateY(-50%);
    user-select: none;
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(-50%) rotate(0deg); }
    50%       { transform: translateY(-54%) rotate(12deg); }
  }

  /* Contenido */
  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: 5rem 6rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .hero__text {
    max-width: 680px;
  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 5.5vw, 4.2rem);
    font-weight: 900;
    line-height: 1.1;
    color: var(--color-white);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .hero__title-accent {
    color: var(--color-secondary);
  }

  .hero__description {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: rgba(255,255,255,0.82);
    max-width: 560px;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .hero__description strong {
    color: var(--color-primary-light);
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Stats */
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 1rem;
    max-width: 680px;
    transition-delay: 0.2s;
  }

  .hero__stat {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: var(--radius-md);
    padding: 1.4rem 1.1rem;
    text-align: center;
    backdrop-filter: blur(6px);
    transition: var(--transition);
  }

  .hero__stat:hover {
    background: rgba(255,255,255,0.14);
    transform: translateY(-3px);
  }

  .hero__stat-value {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    font-weight: 900;
    color: var(--color-secondary);
    line-height: 1.15;
    overflow-wrap: break-word;
  }

  .hero__stat-label {
    display: block;
    font-size: 0.82rem;
    color: rgba(255,255,255,0.65);
    margin-top: 0.4rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* Ola */
  .hero__wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
  }

  .hero__wave svg {
    width: 100%;
    height: 80px;
  }

  @media (max-width: 600px) {
    .hero__volleyball {
      font-size: 12rem;
      opacity: 0.035;
    }

    .hero__content {
      padding-block: 4rem 5rem;
      gap: 2rem;
    }

    .hero__stats {
      grid-template-columns: repeat(2, 1fr);
      max-width: 100%;
    }

    .hero__stat {
      padding: 1.1rem 0.9rem;
    }

    .hero__actions {
      width: 100%;
    }

    .hero__actions .btn {
      flex: 1;
      justify-content: center;
    }
  }

  /* Monitores grandes */
  @media (min-width: 1600px) {
    .hero {
      padding-top: 84px;
    }

    .hero__title {
      font-size: clamp(3rem, 5vw, 5rem);
    }

    .hero__description {
      font-size: 1.3rem;
      max-width: 680px;
    }

    .hero__stats {
      max-width: 900px;
      gap: 1.5rem;
    }

    .hero__stat {
      padding: 2rem 1.5rem;
    }

    .hero__stat-value {
      font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    }

    .hero__stat-label {
      font-size: 1rem;
    }
  }
</style>
