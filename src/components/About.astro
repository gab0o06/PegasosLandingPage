---
// src/components/About.astro
// Sección "Nosotros". Edita los valores y la descripción.

const values = [
  { icon: '🎯', title: 'Disciplina',        desc: 'Formamos hábitos de esfuerzo constante y compromiso que van más allá de la cancha.' },
  { icon: '🤝', title: 'Trabajo en equipo', desc: 'El voleibol es colectivo. Aprendemos que los logros se construyen juntos.' },
  { icon: '❤️', title: 'Pasión',            desc: 'Transmitimos el amor por el deporte como motor de vida y desarrollo personal.' },
  { icon: '🌱', title: 'Comunidad',          desc: 'Somos mucho más que un club: generamos lazos, identidad y sentido de pertenencia.' },
  { icon: '🏐', title: 'Superación',         desc: 'Cada entrenamiento es una oportunidad para superar nuestros límites y crecer.' },
];
---

<section class="about" id="nosotros">
  <div class="container">

    <div class="about__header reveal">
      <span class="badge">Quiénes somos</span>
      <h2 class="section-title">Un proyecto que<br/><em>transforma vidas</em></h2>
      <p class="section-subtitle">
        Pegasos Volleyball UIO nació con la convicción de que el deporte es la mejor
        herramienta para formar personas íntegras. Utilizamos el voleibol como vehículo
        para enseñar valores, crear comunidad y descubrir talentos.
      </p>
    </div>

    <!-- Descripción extendida -->
    <div class="about__body reveal">
      <img
        src="/images/about.jpg"
        alt="Jugador de Club Pegasos Volleyball con camiseta oficial"
        class="about__img"
        loading="lazy"
      />

      <div class="about__description">
        <p>
          Con sede en <strong>Canchas de la Luz</strong>, Quito,
          el Club Pegasos atiende a niños y jóvenes con su <strong>Escuela Formativa (8 a 17 años)</strong> y
          a jugadores con experiencia previa a través de su <strong>Equipo Absoluto Masculino</strong>.
          Entrenamos todo el año los fines de semana (<strong>sábados y domingos de 8:00 a 10:00 am</strong>).
        </p>
        <p>
          Nuestro cuerpo técnico guía a cada deportista con metodología formativa y sistemas competitivos avanzados (5-1),
          preparando tanto las bases técnicas como la competencia en torneos de Quito. Además,
          ¡tu <strong>primera clase de prueba es totalmente GRATIS</strong>!
        </p>
        <a href="#clase-gratis" class="btn btn-primary">Ver clase de prueba gratis →</a>
      </div>
    </div>

    <!-- Valores -->
    <div class="about__values">
      {values.map((v, i) => (
        <div class={`about__value-card reveal`} style={`transition-delay:${i * 0.1}s`}>
          <span class="about__value-icon">{v.icon}</span>
          <h3 class="about__value-title">{v.title}</h3>
          <p class="about__value-desc">{v.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .about {
    padding: var(--section-padding);
    background: var(--color-bg);
  }

  .about__header {
    text-align: center;
    margin-bottom: 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .about__header em {
    color: var(--color-primary);
    font-style: normal;
  }

  .about__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    margin-bottom: 4rem;
  }

  /* Foto de la sección */
  .about__img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .about__description {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about__description p {
    color: var(--color-gray);
    line-height: 1.75;
  }

  .about__description strong {
    color: var(--color-dark);
    font-weight: 600;
  }

  /* Values grid */
  .about__values {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
  }

  @media (max-width: 1100px) {
    .about__values {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 760px) {
    .about__values {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .about__values {
      grid-template-columns: 1fr;
    }
  }

  .about__value-card {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-gray-light);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.1rem;
    transition: var(--transition);
  }

  .about__value-card:hover {
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
  }

  .about__value-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 0.75rem;
  }

  .about__value-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-dark);
    margin-bottom: 0.5rem;
  }

  .about__value-desc {
    font-size: 0.9rem;
    color: var(--color-gray);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .about__body {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .about__img {
      aspect-ratio: 1/1;
    }
  }

  @media (min-width: 1600px) {
    .about__values {
      gap: 1.5rem;
    }

    .about__value-card {
      padding: 1.75rem 1.5rem;
    }

    .about__value-title {
      font-size: 1.15rem;
    }

    .about__value-desc {
      font-size: 0.95rem;
    }
  }
</style>
