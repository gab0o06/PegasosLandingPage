---
// src/pages/index.astro
// Requisitos: proyecto Astro con Tailwind CSS (ver instrucciones al final del chat)
// y un archivo src/styles/global.css con:  @import "tailwindcss";
import "../styles/global.css";

// ───────── CONFIGURACIÓN ─────────
// Cambia este número por el WhatsApp real del club (código de país + número, sin + ni espacios).
const WHATSAPP_NUMBER = "593999999999";

const wa = (text: string) =>
  `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`;

const WA_GENERAL = wa("¡Hola Pegasos! 🏐 Quiero agendar mi clase de prueba GRATIS.");
const WA_FORMATIVA = wa("¡Hola Pegasos! 🏐 Quiero información de la categoría Formativa (8-17 años) y agendar la clase de prueba GRATIS.");
const WA_ABSOLUTO = wa("¡Hola Pegasos! 🏐 Quiero información del Equipo Absoluto Masculino y agendar la clase de prueba GRATIS.");

const MAPS_URL =
  "https://www.google.com/maps/search/?api=1&query=Sede+La+Luz+N88+202+Quito";

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Club Pegasos Volleyball | Voleo de Campeones · Quito</title>
    <meta
      name="description"
      content="Club de voleibol en Quito. Categoría Formativa (8-17 años) y Equipo Absoluto Masculino. Agenda tu clase de prueba GRATIS por WhatsApp."
    />
    <meta name="theme-color" content="#050B1A" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,700;1,800;1,900&family=Barlow:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-[#050B1A] font-body text-slate-200 antialiased selection:bg-[#4DFF9A] selection:text-[#050B1A]">
    <!-- ═════════════ HERO ═════════════ -->
    <header class="relative isolate overflow-hidden">
      <!-- Resplandores de fondo -->
      <div class="pointer-events-none absolute -left-40 -top-40 h-[28rem] w-[28rem] rounded-full bg-teal-500/20 blur-[120px]"></div>
      <div class="pointer-events-none absolute -bottom-40 right-0 h-[26rem] w-[26rem] rounded-full bg-[#4DFF9A]/10 blur-[120px]"></div>

      <!-- Líneas de cancha de voleibol (vista cenital) -->
      <svg
        class="court pointer-events-none absolute -right-24 top-1/2 -z-10 w-[56rem] max-w-none -translate-y-1/2 text-teal-400/25"
        viewBox="0 0 600 340"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        aria-hidden="true"
      >
        <rect x="10" y="10" width="580" height="320" />
        <line x1="300" y1="10" x2="300" y2="330" stroke-width="6" />
        <line x1="200" y1="10" x2="200" y2="330" />
        <line x1="400" y1="10" x2="400" y2="330" />
        <circle cx="300" cy="170" r="46" />
      </svg>

      <!-- Barra superior -->
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6">
        <a href="#top" class="font-display text-2xl font-black italic uppercase tracking-wide text-white md:text-3xl" id="top">
          Pegasos<span class="text-[#4DFF9A]"> Volleyball</span>
        </a>
        <a
          href={WA_GENERAL}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden rounded-sm border border-teal-400/60 px-5 py-2 text-sm font-semibold uppercase tracking-widest text-teal-300 transition hover:border-[#4DFF9A] hover:bg-[#4DFF9A] hover:text-[#050B1A] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#4DFF9A] md:inline-block"
        >
          Escríbenos
        </a>
      </nav>

      <div class="mx-auto max-w-7xl px-6 pb-24 pt-10 md:pb-36 md:pt-20">
        <p class="rise mb-6 inline-block border-l-4 border-[#4DFF9A] pl-3 text-sm font-semibold uppercase tracking-[0.25em] text-teal-300" style="--d:0ms">
          Club de voleibol · Quito
        </p>

        <h1 class="font-display font-black italic uppercase leading-[0.85] tracking-tight text-white">
          <span class="rise block text-[5rem] sm:text-[8rem] lg:text-[11rem]" style="--d:120ms">Voleo de</span>
          <span class="rise outline-text block text-[4.2rem] sm:text-[7rem] lg:text-[10rem]" style="--d:260ms">Campeones</span>
        </h1>

        <p class="rise mt-8 max-w-xl text-lg leading-relaxed text-slate-300 md:text-xl" style="--d:420ms">
          A través del voleibol formamos jugadores, creamos comunidad y transmitimos valores que inspiran.
        </p>

        <div class="rise mt-10" style="--d:560ms">
          <a
            href={WA_GENERAL}
            target="_blank"
            rel="noopener noreferrer"
            class="skew-btn shine glow-pulse group inline-flex items-center gap-4 bg-[#4DFF9A] px-8 py-6 text-[#050B1A] shadow-[0_0_40px_rgba(77,255,154,0.55)] hover:shadow-[0_0_80px_rgba(77,255,154,0.9)] focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-white sm:px-12 sm:py-7"
          >
            <span class="unskew inline-flex items-center gap-4">
              <svg class="h-8 w-8 shrink-0 transition-transform duration-300 group-hover:rotate-12 group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
              </svg>
              <span class="font-display text-3xl font-black italic uppercase leading-none tracking-wide sm:text-5xl">
                💥 Clase de prueba GRATIS
              </span>
            </span>
          </a>
          <p class="mt-5 text-sm text-slate-400">
            Escríbenos por WhatsApp y agenda tu primera clase. Sin compromiso.
          </p>
        </div>
      </div>
    </header>

    <!-- ═════════════ CATEGORÍAS ═════════════ -->
    <section class="relative bg-[#030712]" aria-labelledby="categorias">
      <div class="mx-auto max-w-7xl px-6 pb-10 pt-20 md:pt-28">
        <h2 id="categorias" class="font-display text-5xl font-black italic uppercase tracking-wide text-white md:text-7xl">
          Únete a la manada
        </h2>
        <p class="mt-4 max-w-xl text-lg text-slate-400">
          Dos categorías, una misma exigencia. Elige dónde vas a competir.
        </p>
      </div>

      <div class="grid md:grid-cols-2">
        <!-- FORMATIVA -->
        <article class="panel-left relative flex min-h-[32rem] flex-col justify-between overflow-hidden bg-teal-500 p-8 text-[#04121F] md:p-14 md:pr-24">
          <span class="pointer-events-none absolute -right-6 -top-10 select-none font-display text-[16rem] font-black italic leading-none text-[#04121F]/10 md:text-[22rem]" aria-hidden="true">
            8-17
          </span>

          <div class="relative">
            <h3 class="font-display text-6xl font-black italic uppercase leading-[0.9] tracking-tight md:text-8xl">
              Formativa
            </h3>
            <p class="mt-3 inline-block bg-[#04121F] px-3 py-1 font-display text-2xl font-bold italic uppercase tracking-wide text-[#4DFF9A]">
              8 a 17 años
            </p>
            <p class="mt-6 max-w-md text-lg font-medium leading-relaxed">
              Aprende los fundamentos del voleibol desde cero o sube de nivel. Técnica, juego en equipo y confianza en cada entrenamiento.
            </p>
            <ul class="mt-6 space-y-2 font-semibold">
              <li class="flex items-center gap-3"><span class="h-2 w-6 -skew-x-[20deg] bg-[#04121F]"></span>Fundamentos y técnica</li>
              <li class="flex items-center gap-3"><span class="h-2 w-6 -skew-x-[20deg] bg-[#04121F]"></span>Grupos por edad y nivel</li>
              <li class="flex items-center gap-3"><span class="h-2 w-6 -skew-x-[20deg] bg-[#04121F]"></span>Primeros pasos en competencia</li>
            </ul>
          </div>

          <a
            href={WA_FORMATIVA}
            target="_blank"
            rel="noopener noreferrer"
            class="relative mt-10 inline-flex w-fit items-center gap-3 bg-[#04121F] px-7 py-4 font-display text-xl font-black italic uppercase tracking-wide text-white transition hover:-translate-y-1 hover:bg-white hover:text-[#04121F] hover:shadow-[0_12px_30px_rgba(4,18,31,0.5)] focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-white"
          >
            Quiero entrar a Formativa
          </a>
        </article>

        <!-- ABSOLUTO -->
        <article class="panel-right relative flex min-h-[32rem] flex-col justify-between overflow-hidden border-t-4 border-[#4DFF9A] bg-[#07122B] p-8 md:border-l-0 md:border-t-0 md:p-14 md:pl-24">
          <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_85%_15%,rgba(77,255,154,0.18),transparent_55%)]"></div>

          <div class="relative">
            <h3 class="font-display text-6xl font-black italic uppercase leading-[0.9] tracking-tight text-white md:text-8xl">
              Equipo<br />Absoluto
            </h3>
            <p class="mt-3 inline-block bg-[#4DFF9A] px-3 py-1 font-display text-2xl font-bold italic uppercase tracking-wide text-[#050B1A]">
              Masculino
            </p>
            <p class="mt-6 max-w-md text-lg leading-relaxed text-slate-300">
              Para jugadores que quieren competir en serio. Entrenamiento exigente, ritmo de partido y mentalidad de campeón.
            </p>
            <ul class="mt-6 space-y-2 font-semibold text-white">
              <li class="flex items-center gap-3"><span class="h-2 w-6 -skew-x-[20deg] bg-[#4DFF9A]"></span>Entrenamiento de alta intensidad</li>
              <li class="flex items-center gap-3"><span class="h-2 w-6 -skew-x-[20deg] bg-[#4DFF9A]"></span>Táctica y trabajo de equipo</li>
              <li class="flex items-center gap-3"><span class="h-2 w-6 -skew-x-[20deg] bg-[#4DFF9A]"></span>Enfoque en competencia</li>
            </ul>
          </div>

          <a
            href={WA_ABSOLUTO}
            target="_blank"
            rel="noopener noreferrer"
            class="relative mt-10 inline-flex w-fit items-center gap-3 border-2 border-[#4DFF9A] px-7 py-4 font-display text-xl font-black italic uppercase tracking-wide text-[#4DFF9A] transition hover:-translate-y-1 hover:bg-[#4DFF9A] hover:text-[#050B1A] hover:shadow-[0_0_35px_rgba(77,255,154,0.6)] focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-white"
          >
            Quiero entrar al Absoluto
          </a>
        </article>
      </div>
    </section>

    <!-- ═════════════ BENEFICIOS ═════════════ -->
    <section class="mx-auto max-w-7xl px-6 py-24 md:py-32" aria-labelledby="beneficios">
      <h2 id="beneficios" class="max-w-3xl font-display text-5xl font-black italic uppercase leading-[0.95] tracking-wide text-white md:text-7xl">
        Más que un deporte: un club que te forma
      </h2>

      <div class="mt-14 grid gap-px bg-teal-400/20 md:grid-cols-3">
        <!-- Formación -->
        <div class="group bg-[#050B1A] p-8 transition hover:bg-[#08142E] md:p-10">
          <div class="flex h-16 w-16 items-center justify-center bg-teal-500/15 text-teal-300 ring-1 ring-teal-400/40 transition group-hover:bg-teal-400 group-hover:text-[#050B1A] group-hover:shadow-[0_0_30px_rgba(45,212,191,0.7)]">
            <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <circle cx="12" cy="12" r="6" />
              <circle cx="12" cy="12" r="2" />
            </svg>
          </div>
          <h3 class="mt-6 font-display text-4xl font-black italic uppercase tracking-wide text-white">Formación</h3>
          <p class="mt-3 leading-relaxed text-slate-400">
            Técnica, táctica y condición física con un entrenamiento progresivo que te hace mejorar clase tras clase.
          </p>
        </div>

        <!-- Comunidad -->
        <div class="group bg-[#050B1A] p-8 transition hover:bg-[#08142E] md:p-10">
          <div class="flex h-16 w-16 items-center justify-center bg-teal-500/15 text-teal-300 ring-1 ring-teal-400/40 transition group-hover:bg-teal-400 group-hover:text-[#050B1A] group-hover:shadow-[0_0_30px_rgba(45,212,191,0.7)]">
            <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
              <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
          </div>
          <h3 class="mt-6 font-display text-4xl font-black italic uppercase tracking-wide text-white">Comunidad</h3>
          <p class="mt-3 leading-relaxed text-slate-400">
            Se entrena en grupo, se celebra en grupo. Aquí encuentras compañeros, amigos y una manada que te respalda.
          </p>
        </div>

        <!-- Valores -->
        <div class="group bg-[#050B1A] p-8 transition hover:bg-[#08142E] md:p-10">
          <div class="flex h-16 w-16 items-center justify-center bg-teal-500/15 text-teal-300 ring-1 ring-teal-400/40 transition group-hover:bg-teal-400 group-hover:text-[#050B1A] group-hover:shadow-[0_0_30px_rgba(45,212,191,0.7)]">
            <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
              <path d="m9 12 2 2 4-4" />
            </svg>
          </div>
          <h3 class="mt-6 font-display text-4xl font-black italic uppercase tracking-wide text-white">Valores</h3>
          <p class="mt-3 leading-relaxed text-slate-400">
            Disciplina, respeto y trabajo en equipo, dentro y fuera de la cancha. Valores que inspiran.
          </p>
        </div>
      </div>
    </section>

    <!-- ═════════════ CTA FINAL + UBICACIÓN ═════════════ -->
    <section class="cta-band relative isolate overflow-hidden" aria-labelledby="cta-final">
      <svg
        class="pointer-events-none absolute -left-20 top-1/2 -z-10 w-[50rem] max-w-none -translate-y-1/2 text-[#050B1A]/15"
        viewBox="0 0 600 340"
        fill="none"
        stroke="currentColor"
        stroke-width="4"
        aria-hidden="true"
      >
        <rect x="10" y="10" width="580" height="320" />
        <line x1="300" y1="10" x2="300" y2="330" stroke-width="8" />
        <line x1="200" y1="10" x2="200" y2="330" />
        <line x1="400" y1="10" x2="400" y2="330" />
      </svg>

      <div class="mx-auto flex max-w-7xl flex-col items-start gap-10 px-6 py-20 md:flex-row md:items-center md:justify-between md:py-28">
        <div class="max-w-2xl text-[#050B1A]">
          <h2 id="cta-final" class="font-display text-6xl font-black italic uppercase leading-[0.9] tracking-tight md:text-8xl">
            Tu primera clase es gratis
          </h2>
          <p class="mt-5 text-lg font-semibold md:text-xl">
            Escríbenos por WhatsApp, elige tu categoría y ven a probar con el club.
          </p>

          <a
            href={MAPS_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-flex items-start gap-3 bg-[#050B1A] px-5 py-4 text-white transition hover:bg-[#0B1B3F] focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-[#050B1A]"
          >
            <svg class="mt-0.5 h-6 w-6 shrink-0 text-[#4DFF9A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <span>
              <span class="block font-display text-2xl font-black italic uppercase tracking-wide">Sede La Luz</span>
              <span class="block text-sm text-slate-300">N88 202, Quito · Ver en el mapa</span>
            </span>
          </a>
        </div>

        <a
          href={WA_GENERAL}
          target="_blank"
          rel="noopener noreferrer"
          class="skew-btn shine group inline-flex shrink-0 items-center bg-[#050B1A] px-10 py-7 text-[#4DFF9A] shadow-[0_18px_0_-6px_rgba(5,11,26,0.35)] hover:bg-white hover:text-[#050B1A] focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-[#050B1A]"
        >
          <span class="unskew inline-flex items-center gap-3">
            <svg class="h-8 w-8 transition-transform duration-300 group-hover:rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
            </svg>
            <span class="font-display text-3xl font-black italic uppercase tracking-wide sm:text-4xl">Escribir por WhatsApp</span>
          </span>
        </a>
      </div>
    </section>

    <!-- ═════════════ FOOTER ═════════════ -->
    <footer class="bg-[#030712] px-6 pb-28 pt-10 md:pb-10">
      <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-3 text-sm text-slate-500 md:flex-row md:items-center">
        <p class="font-display text-xl font-black italic uppercase tracking-wide text-slate-300">
          Club Pegasos Volleyball · Voleo de Campeones
        </p>
        <p>© {year} Club Pegasos Volleyball. Quito, Ecuador.</p>
      </div>
    </footer>

    <!-- Barra fija de WhatsApp (solo móvil) -->
    <div class="fixed inset-x-0 bottom-0 z-50 border-t border-[#4DFF9A]/40 bg-[#050B1A]/95 p-3 backdrop-blur md:hidden">
      <a
        href={WA_GENERAL}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-3 bg-[#4DFF9A] py-4 font-display text-2xl font-black italic uppercase tracking-wide text-[#050B1A] shadow-[0_0_30px_rgba(77,255,154,0.5)] active:scale-[0.98]"
      >
        💥 Clase de prueba GRATIS
      </a>
    </div>
  </body>
</html>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(.font-display) {
    font-family: "Barlow Condensed", "Arial Narrow", Impact, sans-serif;
  }
  :global(.font-body) {
    font-family: "Barlow", system-ui, -apple-system, "Segoe UI", sans-serif;
  }

  /* Texto contorneado para "Campeones" */
  .outline-text {
    color: transparent;
    -webkit-text-stroke: 2px #2dd4bf;
    text-shadow: 0 0 40px rgba(45, 212, 191, 0.45);
  }
  @media (min-width: 1024px) {
    .outline-text {
      -webkit-text-stroke: 3px #2dd4bf;
    }
  }

  /* Botones inclinados estilo e-sports */
  .skew-btn {
    transform: skewX(-10deg);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease, color 0.25s ease;
  }
  .skew-btn:hover {
    transform: skewX(-10deg) scale(1.05);
  }
  .unskew {
    transform: skewX(10deg);
  }

  /* Destello que cruza el botón al pasar el cursor */
  .shine {
    position: relative;
    overflow: hidden;
  }
  .shine::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 35%, rgba(255, 255, 255, 0.65) 50%, transparent 65%);
    transform: translateX(-130%);
    transition: transform 0.7s ease;
    pointer-events: none;
  }
  .shine:hover::after {
    transform: translateX(130%);
  }

  /* Paneles de categorías con corte diagonal (solo escritorio) */
  @media (min-width: 768px) {
    .panel-left {
      clip-path: polygon(0 0, 100% 0, calc(100% - 4rem) 100%, 0 100%);
    }
    .panel-right {
      clip-path: polygon(4rem 0, 100% 0, 100% 100%, 0 100%);
      margin-left: -4rem;
    }
  }

  /* Banda final */
  .cta-band {
    background: linear-gradient(120deg, #2dd4bf 0%, #4dff9a 100%);
  }

  /* Animaciones: solo si el usuario no pidió reducir el movimiento */
  @media (prefers-reduced-motion: no-preference) {
    .rise {
      opacity: 0;
      transform: translateY(40px) skewX(-6deg);
      animation: rise 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
      animation-delay: var(--d, 0ms);
    }
    @keyframes rise {
      to {
        opacity: 1;
        transform: none;
      }
    }

    .glow-pulse {
      animation: glow 2.6s ease-in-out infinite;
    }
    @keyframes glow {
      0%,
      100% {
        box-shadow: 0 0 40px rgba(77, 255, 154, 0.45);
      }
      50% {
        box-shadow: 0 0 80px rgba(77, 255, 154, 0.85);
      }
    }
    .glow-pulse:hover {
      animation: none;
    }

    .court {
      transform-origin: center;
      animation: drift 14s ease-in-out infinite alternate;
    }
    @keyframes drift {
      from {
        transform: translateY(-50%) rotate(-3deg);
      }
      to {
        transform: translateY(-50%) rotate(2deg);
      }
    }
  }
</style>
