---
// src/pages/index.astro — Pegasos Volleyball UIO (Opción 4: Elite Modern Pro / Dark Glass Athletic)
import "../styles/global.css";

// ───────── CONFIGURACIÓN OFICIAL ─────────
// Número oficial de WhatsApp del club (Quito, Ecuador)
const WHATSAPP_NUMBER = "593984917908";

const wa = (text: string) =>
  `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`;

const WA_GENERAL = wa("¡Hola Pegasos! 🏐 Quiero agendar mi clase de prueba GRATIS.");
const WA_FORMATIVA = wa("¡Hola Pegasos! 🏐 Quiero información de la categoría Formativa (8-17 años) y agendar la clase de prueba GRATIS.");
const WA_ABSOLUTO = wa("¡Hola Pegasos! 🏐 Quiero información del Equipo Absoluto Masculino y agendar la clase de prueba GRATIS.");
const WA_PERMANENTE = wa("¡Hola Pegasos! 🏐 Quisiera consultar detalles y cupos de la Escuela Permanente.");

const MAPS_URL = "https://maps.app.goo.gl/kVhMB9aU66foGMFR7";
const year = new Date().getFullYear();

// Fotos reales del club
const galeriaFotos = [
  {
    src: "/images/equipo.jpg",
    alt: "Equipo Pegasos Volleyball en reunión técnica",
    tag: "Comunidad & Unión",
    title: "La Manada Pegasos",
  },
  {
    src: "/images/entrenamiento.jpg",
    alt: "Entrenamiento formativo en Canchas de la Luz",
    tag: "Técnica & Práctica",
    title: "Entrenamiento en Cancha",
  },
  {
    src: "/images/accion.jpg",
    alt: "Jugadora rematando sobre la red",
    tag: "Intensidad",
    title: "Ataque y Potencia",
  },
  {
    src: "/images/about.jpg",
    alt: "Jugador de Pegasos con uniforme oficial",
    tag: "Identidad",
    title: "Orgullo Pegasos",
  },
];

// Valores del club
const valores = [
  {
    icon: "🎯",
    title: "Técnica & Disciplina",
    desc: "Metodología progresiva paso a paso para dominar voleo, saque, recepción y remate con base sólida.",
    color: "from-cyan-500/20 to-blue-500/5",
    border: "group-hover:border-cyan-400/50",
    glow: "group-hover:shadow-[0_0_30px_rgba(6,182,212,0.25)]",
  },
  {
    icon: "🤝",
    title: "Comunidad & Hermandad",
    desc: "En Pegasos nadie juega solo. Fomentamos el compañerismo, respeto y apoyo mutuo dentro y fuera de la cancha.",
    color: "from-emerald-500/20 to-teal-500/5",
    border: "group-hover:border-emerald-400/50",
    glow: "group-hover:shadow-[0_0_30px_rgba(16,185,129,0.25)]",
  },
  {
    icon: "⚡",
    title: "Mentalidad Competitiva",
    desc: "Partidos de fogueo, torneos y situaciones de juego real para forjar carácter, temple y resiliencia.",
    color: "from-amber-500/20 to-orange-500/5",
    border: "group-hover:border-amber-400/50",
    glow: "group-hover:shadow-[0_0_30px_rgba(245,158,11,0.25)]",
  },
  {
    icon: "🌱",
    title: "Valores para la Vida",
    desc: "El deporte como herramienta para formar hábitos positivos, compromiso y superación personal permanente.",
    color: "from-teal-500/20 to-cyan-500/5",
    border: "group-hover:border-teal-400/50",
    glow: "group-hover:shadow-[0_0_30px_rgba(20,184,166,0.25)]",
  },
];

// Preguntas frecuentes
const faqs = [
  {
    q: "¿Mi hijo/a nunca ha practicado voleibol, puede unirse?",
    a: "¡Totalmente! En la categoría Formativa enseñamos la técnica desde cero con metodología progresiva y adecuada a su ritmo.",
  },
  {
    q: "¿Cómo funciona la clase de prueba GRATIS?",
    a: "Solo debes hacer clic en cualquiera de nuestros botones de WhatsApp, coordinamos el día que prefieras (sábado o domingo) y asistes sin ningún costo ni compromiso previo.",
  },
  {
    q: "¿Qué días y en qué horarios entrenan?",
    a: "Entrenamos los fines de semana: sábados y domingos de 10:00 a 12:30 en Canchas de La Luz, Quito.",
  },
  {
    q: "¿Qué implementos se necesitan para la primera clase?",
    a: "Únicamente ropa deportiva cómoda, zapatillas deportivas con buen agarre y tu botella de agua para hidratación. Nosotros proveemos balones e infraestructura.",
  },
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Club Pegasos Volleyball | Voleo de Campeones · Quito</title>
    <meta
      name="description"
      content="Club Pegasos Volleyball en Quito. Escuela formativa (8 a 17 años) y Equipo Absoluto Masculino. Entrena en Canchas de La Luz. ¡Agenda tu clase de prueba GRATIS!"
    />
    <meta name="theme-color" content="#070D18" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/logo-badge.png" />

    <!-- Google Fonts: Outfit (Titulares atléticos modernos) + Plus Jakarta Sans (Lectura pulida) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-[#060B14] font-['Plus_Jakarta_Sans',sans-serif] text-slate-200 antialiased selection:bg-cyan-400 selection:text-slate-950">
    <!-- ═════════════ BARRA DE ANUNCIO SUPERIOR ═════════════ -->
    <div class="relative z-50 bg-gradient-to-r from-cyan-950 via-slate-900 to-emerald-950 border-b border-cyan-500/20 py-2.5 px-4 text-center text-xs sm:text-sm font-medium text-slate-300">
      <div class="mx-auto flex max-w-7xl items-center justify-center gap-2 flex-wrap">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/20 px-2.5 py-0.5 text-xs font-semibold text-emerald-400 border border-emerald-500/30">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          INSCRIPCIONES ABIERTAS {year}
        </span>
        <span>Entrena en Canchas de la Luz · Sábados y Domingos 10:00 - 12:30</span>
        <a href={WA_GENERAL} target="_blank" rel="noopener noreferrer" class="text-cyan-400 font-semibold hover:text-cyan-300 underline underline-offset-2 ml-1">
          Primera clase de prueba GRATIS →
        </a>
      </div>
    </div>

    <!-- ═════════════ FLOATING GLASS NAVBAR ═════════════ -->
    <header class="sticky top-0 z-40 w-full backdrop-blur-xl bg-[#060B14]/85 border-b border-white/[0.08] transition-all duration-300">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 py-3.5">
        <!-- Logo y Marca -->
        <a href="#top" class="flex items-center gap-3 group">
          <div class="relative h-11 w-11 shrink-0 overflow-hidden rounded-xl bg-gradient-to-br from-cyan-500/20 to-emerald-500/10 p-1 border border-cyan-500/30 transition group-hover:scale-105 group-hover:border-cyan-400/60 shadow-[0_0_15px_rgba(6,182,212,0.2)]">
            <img src="/images/logo-transparent.png" alt="Logo Pegasos Volleyball" class="h-full w-full object-contain" />
          </div>
          <div>
            <span class="block font-['Outfit',sans-serif] text-xl font-black uppercase tracking-wider text-white group-hover:text-cyan-400 transition-colors">
              Pegasos <span class="text-cyan-400 group-hover:text-emerald-400 transition-colors">Volleyball</span>
            </span>
            <span class="block text-[10px] font-semibold tracking-widest uppercase text-slate-400">
              Quito · Ecuador
            </span>
          </div>
        </a>

        <!-- Menú Desktop -->
        <nav class="hidden md:flex items-center gap-7 text-sm font-semibold tracking-wide text-slate-300">
          <a href="#categorias" class="transition hover:text-cyan-400 hover:-translate-y-0.5">Categorías</a>
          <a href="#permanente" class="transition hover:text-cyan-400 hover:-translate-y-0.5">Escuela Permanente</a>
          <a href="#valores" class="transition hover:text-cyan-400 hover:-translate-y-0.5">Valores</a>
          <a href="#galeria" class="transition hover:text-cyan-400 hover:-translate-y-0.5">Galería</a>
          <a href="#sede" class="transition hover:text-cyan-400 hover:-translate-y-0.5">Sede & Horarios</a>
          <a href="#faqs" class="transition hover:text-cyan-400 hover:-translate-y-0.5">Preguntas</a>
        </nav>

        <!-- CTA WhatsApp Navbar -->
        <div class="flex items-center gap-3">
          <a
            href={WA_GENERAL}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-cyan-400 to-emerald-400 px-5 py-2.5 text-xs md:text-sm font-extrabold uppercase tracking-wider text-slate-950 transition hover:shadow-[0_0_25px_rgba(6,182,212,0.6)] hover:scale-105 active:scale-95"
          >
            <span>Clase Gratis</span>
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>

          <!-- Botón móvil toggle -->
          <button
            id="mobileMenuBtn"
            type="button"
            class="md:hidden flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-slate-300 hover:text-white"
            aria-label="Abrir menú"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Menú desplegable móvil -->
      <div id="mobileMenu" class="hidden md:hidden border-t border-white/10 bg-[#060B14]/98 px-6 py-5 backdrop-blur-2xl">
        <nav class="flex flex-col gap-4 text-base font-semibold text-slate-200">
          <a href="#categorias" class="mobile-nav-link py-1 hover:text-cyan-400">Categorías</a>
          <a href="#permanente" class="mobile-nav-link py-1 hover:text-cyan-400">Escuela Permanente</a>
          <a href="#valores" class="mobile-nav-link py-1 hover:text-cyan-400">Valores</a>
          <a href="#galeria" class="mobile-nav-link py-1 hover:text-cyan-400">Galería</a>
          <a href="#sede" class="mobile-nav-link py-1 hover:text-cyan-400">Sede & Horarios</a>
          <a href="#faqs" class="mobile-nav-link py-1 hover:text-cyan-400">Preguntas Frecuentes</a>
          <a
            href={WA_GENERAL}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-cyan-400 to-emerald-400 px-5 py-3 text-center font-extrabold uppercase text-slate-950"
          >
            Agendar Clase de Prueba Gratis
          </a>
        </nav>
      </div>
    </header>

    <main id="top">
      <!-- ═════════════ HERO SECTION (PRO ATHLETIC GLASS) ═════════════ -->
      <section class="relative isolate min-h-[90vh] overflow-hidden pt-8 pb-20 md:pt-16 md:pb-32 flex items-center">
        <!-- Foto de fondo del club con opacidad y blending cinematográfico -->
        <div class="pointer-events-none absolute inset-0 -z-20 overflow-hidden">
          <img
            src="/images/hero.jpg"
            alt="Fondo Pegasos Volleyball"
            class="h-full w-full object-cover object-center opacity-25 scale-105 filter blur-[2px]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#060B14] via-[#060B14]/85 to-[#060B14]/70"></div>
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,rgba(6,182,212,0.25),transparent_75%)]"></div>
          <div class="absolute -right-32 bottom-0 h-96 w-96 rounded-full bg-emerald-500/10 blur-[130px]"></div>
        </div>

        <!-- Líneas estilizadas de cancha de voleibol (SVG) -->
        <svg
          class="pointer-events-none absolute right-0 top-1/2 -z-10 h-[38rem] w-[50rem] -translate-y-1/2 translate-x-1/4 stroke-cyan-500/15 opacity-80"
          viewBox="0 0 600 340"
          fill="none"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <rect x="10" y="10" width="580" height="320" rx="8" />
          <line x1="300" y1="10" x2="300" y2="330" stroke-width="5" stroke-dasharray="8 6" />
          <line x1="200" y1="10" x2="200" y2="330" />
          <line x1="400" y1="10" x2="400" y2="330" />
          <circle cx="300" cy="170" r="50" />
        </svg>

        <div class="mx-auto max-w-7xl px-4 sm:px-6 w-full">
          <div class="max-w-4xl">
            <!-- Badge superior con pulso -->
            <div class="inline-flex items-center gap-2.5 rounded-full border border-cyan-400/40 bg-cyan-950/40 px-4 py-1.5 backdrop-blur-md mb-6 shadow-[0_0_20px_rgba(6,182,212,0.25)]">
              <span class="flex h-2 w-2 rounded-full bg-cyan-400 animate-ping"></span>
              <span class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-cyan-300">
                Club Pegasos Volleyball · Quito, Ecuador
              </span>
            </div>

            <!-- Gran Título Impactante -->
            <h1 class="font-['Outfit',sans-serif] text-5xl sm:text-7xl lg:text-9xl font-black uppercase tracking-tight leading-[0.9] text-white">
              Voleo de
              <span class="block bg-gradient-to-r from-cyan-300 via-teal-200 to-emerald-400 bg-clip-text text-transparent drop-shadow-[0_0_35px_rgba(6,182,212,0.4)]">
                Campeones
              </span>
            </h1>

            <p class="mt-6 max-w-2xl text-lg sm:text-xl leading-relaxed text-slate-300 font-normal">
              Mucho más que una escuela de voleibol: formamos atletas íntegros, creamos una verdadera comunidad y transmitimos valores que inspiran en cada entrenamiento.
            </p>

            <!-- Acciones CTA principales -->
            <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
              <a
                href={WA_GENERAL}
                target="_blank"
                rel="noopener noreferrer"
                class="group relative inline-flex items-center justify-center gap-3 overflow-hidden rounded-2xl bg-gradient-to-r from-cyan-400 via-teal-300 to-emerald-400 px-8 py-5 text-base sm:text-lg font-black uppercase tracking-wide text-slate-950 shadow-[0_0_35px_rgba(6,182,212,0.45)] transition-all duration-300 hover:scale-[1.03] hover:shadow-[0_0_55px_rgba(16,185,129,0.7)] active:scale-95"
              >
                <span class="text-xl">💥</span>
                <span>Clase de prueba GRATIS</span>
                <svg class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>

              <a
                href="#categorias"
                class="inline-flex items-center justify-center gap-2 rounded-2xl border border-white/20 bg-slate-900/60 px-7 py-5 text-sm sm:text-base font-bold uppercase tracking-wider text-slate-200 backdrop-blur-md transition hover:border-cyan-400 hover:bg-slate-800/80 hover:text-white"
              >
                <span>Ver Categorías</span>
                <span class="text-cyan-400">↓</span>
              </a>
            </div>

            <!-- Micro text WhatsApp -->
            <p class="mt-4 text-xs sm:text-sm text-slate-400 flex items-center gap-2">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              Atención directa por WhatsApp al <strong>0984917908</strong>. Cupos limitados por grupo.
            </p>
          </div>

          <!-- Tarjetas de Stats en Glassmorphism -->
          <div class="mt-14 sm:mt-20 grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-5">
            <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-4 sm:p-5 backdrop-blur-xl transition hover:border-cyan-500/40 hover:bg-slate-900/70">
              <span class="block font-['Outfit',sans-serif] text-2xl sm:text-4xl font-extrabold text-cyan-400">8 a 17</span>
              <span class="mt-1 block text-xs sm:text-sm font-semibold text-slate-300">Años en Formativa</span>
              <span class="text-[11px] text-slate-400">Niños y jóvenes</span>
            </div>

            <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-4 sm:p-5 backdrop-blur-xl transition hover:border-cyan-500/40 hover:bg-slate-900/70">
              <span class="block font-['Outfit',sans-serif] text-2xl sm:text-4xl font-extrabold text-emerald-400">Sáb & Dom</span>
              <span class="mt-1 block text-xs sm:text-sm font-semibold text-slate-300">10:00 a 12:30</span>
              <span class="text-[11px] text-slate-400">Entrenamiento continuo</span>
            </div>

            <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-4 sm:p-5 backdrop-blur-xl transition hover:border-cyan-500/40 hover:bg-slate-900/70">
              <span class="block font-['Outfit',sans-serif] text-2xl sm:text-4xl font-extrabold text-teal-300">La Luz</span>
              <span class="mt-1 block text-xs sm:text-sm font-semibold text-slate-300">Canchas de la Luz</span>
              <span class="text-[11px] text-slate-400">Sede Norte · Quito</span>
            </div>

            <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-4 sm:p-5 backdrop-blur-xl transition hover:border-cyan-500/40 hover:bg-slate-900/70">
              <span class="block font-['Outfit',sans-serif] text-2xl sm:text-4xl font-extrabold text-cyan-300">100%</span>
              <span class="mt-1 block text-xs sm:text-sm font-semibold text-slate-300">Prueba Gratis</span>
              <span class="text-[11px] text-slate-400">Ven a probar sin costo</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ═════════════ CATEGORÍAS PRINCIPALES (FORMATIVA & ABSOLUTO) ═════════════ -->
      <section id="categorias" class="relative py-20 md:py-32 bg-[#050810] border-t border-white/5">
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
          <div class="text-center max-w-3xl mx-auto">
            <span class="inline-block rounded-full bg-cyan-500/10 px-4 py-1.5 text-xs font-bold tracking-widest uppercase text-cyan-400 border border-cyan-500/20">
              Elige tu nivel de juego
            </span>
            <h2 class="mt-3 font-['Outfit',sans-serif] text-4xl sm:text-6xl font-black uppercase tracking-tight text-white">
              Únete a la <span class="text-cyan-400">Manada Pegasos</span>
            </h2>
            <p class="mt-4 text-base sm:text-lg text-slate-300">
              Dos categorías pensadas para cada momento de tu formación deportiva: desde tus primeros toques hasta la más alta competencia.
            </p>
          </div>

          <!-- Cards de las Categorías con diseño de alto voltaje -->
          <div class="mt-14 grid gap-8 lg:grid-cols-2">
            <!-- CATEGORÍA 1: FORMATIVA -->
            <div class="group relative overflow-hidden rounded-3xl border border-cyan-500/30 bg-gradient-to-b from-slate-900/90 to-[#0A1224] p-8 sm:p-12 shadow-[0_0_30px_rgba(6,182,212,0.15)] transition-all duration-300 hover:border-cyan-400 hover:shadow-[0_0_50px_rgba(6,182,212,0.3)]">
              <!-- Background accent glow -->
              <div class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-cyan-500/15 blur-3xl transition duration-500 group-hover:scale-125"></div>

              <div class="flex items-center justify-between gap-4">
                <span class="rounded-full bg-cyan-400/15 px-3.5 py-1 text-xs font-extrabold uppercase tracking-wider text-cyan-300 border border-cyan-400/30">
                  Escuela Continua
                </span>
                <span class="font-['Outfit',sans-serif] text-3xl sm:text-4xl font-black text-cyan-400">
                  8 a 17 años
                </span>
              </div>

              <h3 class="mt-6 font-['Outfit',sans-serif] text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">
                Categoría Formativa
              </h3>
              <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
                Diseñada para niños y jóvenes que inician desde cero o buscan afianzar sus bases técnicas con entrenadores dedicados y en un ambiente motivador.
              </p>

              <div class="mt-8 space-y-3.5 border-y border-white/10 py-6">
                <div class="flex items-start gap-3">
                  <div class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-cyan-400/20 text-cyan-400">
